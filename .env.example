# Documentation only. Generate a usable .env with:
# uv run python -m scripts.generate_demo_secret
# A2A_HMAC_SECRET must be a locally generated 64-character hexadecimal value.
A2A_HMAC_SECRET=

# Optional defaults; the workflow matrix overrides these per configuration.
MODE=baseline
ATTACK=none
REQUEST_AUTHENTICATION=off
REPLAY_PROTECTION=off
PASSPORT_TTL_SECONDS=300
PATIENT_URL=http://127.0.0.1:12000
HOSPITAL_URL=http://127.0.0.1:12001
INSURANCE_URL=http://127.0.0.1:12002
